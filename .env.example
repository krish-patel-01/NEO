# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=

# Wolfram Alpha App ID — https://developer.wolframalpha.com/
WOLFRAM_ALPHA_APPID=

# Optional: override the Groq model (defaults to llama-3.3-70b-versatile)
# NEO_MODEL=llama-3.3-70b-versatile

# Optional: SearXNG instance the general_search tool queries
# SEARXNG_HOST=http://127.0.0.1:8080

# Optional: SearXNG server secret, overrides settings.yml
# Generate with: openssl rand -hex 32
# SEARXNG_SECRET=
